<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Device Name -->
        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RHID-1"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Make/Model -->
        <TextView
            android:id="@+id/tvMakeModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apple iPhone 15 Pro"
            android:textColor="#BBBBBB"
            android:textSize="16sp"
            android:layout_marginTop="4dp" />

        <!-- Current MAC -->
        <TextView
            android:id="@+id/tvMac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current MAC: D2:3F:8A:1B:9C:4E"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginTop="12dp" />

        <!-- Probed SSIDs -->
        <TextView
            android:id="@+id/tvSsids"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Probing: Starbucks_WiFi, xfinitywifi, HomeNetwork"
            android:textColor="#88FFFFFF"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:layout_marginTop="8dp" />

        <!-- RSSI -->
        <TextView
            android:id="@+id/tvRssi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RSSI: -52 dBm"
            android:textColor="#00FF00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <!-- Seen Count -->
        <TextView
            android:id="@+id/tvSeen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seen: 47 times"
            android:textColor="#88FFFFFF"
            android:layout_marginTop="4dp" />

        <!-- RHID Info -->
        <TextView
            android:id="@+id/tvRandomizedInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RHID-1 • 3 MACs observed"
            android:textColor="#FFFF9800"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#33FF5722"
            android:padding="8dp"
            android:layout_marginTop="16dp" />

        <!-- Embedded Hunting Map -->
        <com.google.android.gms.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="24dp"
            android:background="#000000" />

        <!-- Deauth Attack Button -->
        <Button
            android:id="@+id/btnDeauth"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="FORCE PROBE REQUESTS (DEAUTH)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FFFF5722"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <!-- BLE Connect Button — FIXED: & → &amp; -->
        <Button
            android:id="@+id/btnBleConnect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CONNECT BLE &amp; READ BATTERY"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF6200EE"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>