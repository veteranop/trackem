<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMakeModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Make Model"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Name"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvIdentifierLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Identifier" 
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvIdentifierValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        
        <TextView
            android:id="@+id/tvIdentifierType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="italic"/>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true" 
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvVendorLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vendor Details" 
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvVendorCompany"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvVendorAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        
        <TextView
            android:id="@+id/tvVendorCountry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvBlockDetailsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAC Block Details"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvMacPrefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnMapDevice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Map This Device"
            android:layout_marginTop="16dp"/>
        
        <Button
            android:id="@+id/btnShodanLookup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shodan Lookup"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvSsidLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beaconed SSIDs"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <LinearLayout
            android:id="@+id/ssidContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>