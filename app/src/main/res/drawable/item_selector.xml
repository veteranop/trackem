<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"><!-- State when the item is pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4F4F51" /> <!-- A slightly lighter color for pressed state -->
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Default, non-pressed state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2C2C2E" /> <!-- The default background color -->
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
